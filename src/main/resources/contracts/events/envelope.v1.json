{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoplite.internal/schemas/events/envelope.v1.json",
  "title": "ShopLiteEventEnvelopeV1",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 3
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": ["string", "number"]
    },
    "payload": {
      "type": "object"
    }
  }
}
