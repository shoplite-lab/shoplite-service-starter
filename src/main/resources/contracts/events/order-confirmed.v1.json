{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoplite.internal/schemas/events/order-confirmed.v1.json",
  "title": "OrderConfirmedEventV1",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "order.confirmed" },
    "schemaVersion": { "type": "string", "default": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": ["string", "number"] },
    "payload": {
      "type": "object",
      "required": ["orderId", "userId", "username", "items", "totalAmount"],
      "properties": {
        "orderId": { "type": "integer" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "totalAmount": { "type": "number", "minimum": 0 },
        "paymentMethod": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["productId", "productName", "quantity", "unitPrice"],
            "properties": {
              "productId": { "type": "integer" },
              "productName": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "unitPrice": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
