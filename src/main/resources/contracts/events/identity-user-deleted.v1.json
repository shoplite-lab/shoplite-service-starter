{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoplite.internal/schemas/events/identity-user-deleted.v1.json",
  "title": "IdentityUserDeletedEventV1",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "identity.user-deleted" },
    "schemaVersion": { "type": "string", "default": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": ["string", "number"] },
    "payload": {
      "type": "object",
      "required": ["userId", "realm"],
      "properties": {
        "userId": { "type": "string" },
        "realm": { "type": "string" },
        "source": { "type": "string" }
      }
    }
  }
}
