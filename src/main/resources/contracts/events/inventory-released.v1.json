{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoplite.internal/schemas/events/inventory-released.v1.json",
  "title": "InventoryReleasedEventV1",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "inventory.released" },
    "schemaVersion": { "type": "string", "default": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": ["string", "number"] },
    "payload": {
      "type": "object",
      "required": ["orderId", "reason"],
      "properties": {
        "orderId": { "type": "integer" },
        "reservationId": { "type": ["integer", "null"] },
        "reason": { "type": "string" }
      }
    }
  }
}
